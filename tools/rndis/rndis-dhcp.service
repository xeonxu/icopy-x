[Unit]
Description=DHCP server for the iCopy-X USB network link
After=rndis.service
Wants=rndis.service
# The argument list depends on the profile and the subnet, so rndis.sh writes it
# and this unit only consumes it. Absent means no gateway role is configured.
ConditionPathExists=/run/icopy-dnsmasq.conf

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/icopy-dnsmasq.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
